{
  "name": "morit-app",
  "version": "1.0.10",
  "description": "MoritApp multi-session desktop workspace client",
  "main": "main.js",
  "author": "MoritApp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgs142c/MoritApp.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "release:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.moritapp.desktop",
    "productName": "MoritApp",
    "copyright": "Copyright © MoritApp",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kgs142c",
        "repo": "MoritApp",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "supabase.config.example.json"
    ],
    "extraResources": [
      {
        "from": "music",
        "to": "music",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MoritApp-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MoritApp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "electron-updater": "^6.8.9"
  }
}
