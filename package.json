{
  "name": "morit-app",
  "version": "1.0.13",
  "description": "MoritApp multi-session desktop workspace client",
  "main": "main.js",
  "author": {
    "name": "MoritApp",
    "email": "kgs142c@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgs142c/MoritApp.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.moritapp.desktop",
    "productName": "MoritApp",
    "copyright": "Copyright © MoritApp",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kgs142c",
        "repo": "MoritApp",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "supabase.config.example.json"
    ],
    "extraResources": [
      {
        "from": "music",
        "to": "music",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icons/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MoritApp-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "MoritApp-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "artifactName": "MoritApp-${version}-linux-${arch}.${ext}",
      "maintainer": "MoritApp <kgs142c@users.noreply.github.com>",
      "synopsis": "MoritApp multi-session desktop workspace",
      "description": "Multi-session Discord desktop client with local save and auto-update.",
      "desktop": {
        "Name": "MoritApp",
        "Comment": "MoritApp multi-session desktop workspace",
        "Categories": "Network;InstantMessaging;"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MoritApp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "electron-updater": "^6.8.9"
  }
}
